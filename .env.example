# Application Settings
PORT=5000

# MongoDB Database Connection String
# Replace <username>, <password>, and <cluster-url> with your MongoDB Atlas or local MongoDB URI
# Example Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/ift?retryWrites=true&w=majority
# Example Local: mongodb://127.0.0.1:27017/ift
MONGO_URI=

# Razorpay Payment Gateway Keys (Optional for local dev unless processing payments)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Brevo Transactional Email Key & Sender Details
BREVO_API_KEY=
BREVO_SENDER_EMAIL=sales.iftchennai@gmail.com
BREVO_SENDER_NAME=IFT Chennai

# Admin User Seed Details
ADMIN_EMAIL=gostman064@gmail.com
ADMIN_UID=admin-user-456
ADMIN_DISPLAY_NAME=Store Admin
